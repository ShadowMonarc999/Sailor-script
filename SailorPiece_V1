-- FUNÇÃO: Verifica se o Haki Armamento está ativo
local function HakiArmamentoAtivo()
    local char = game.Players.LocalPlayer.Character
    if not char then return false end

    -- Procura pelos braços
    local bracoDireito = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
    local bracoEsquerdo = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")

    -- Verifica se os braços estão pretos
    if bracoDireito and bracoDireito.BrickColor == BrickColor.new("Really black") then
        return true
    end
    if bracoEsquerdo and bracoEsquerdo.BrickColor == BrickColor.new("Really black") then
        return true
    end

    return false
end

