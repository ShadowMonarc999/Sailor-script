-- Função: encontra o primeiro mob vivo da lista
local function FindMob(targetNames)
    local player = game.Players.LocalPlayer
    if not player or not player.Character then return nil end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            for _, name in ipairs(targetNames) do
                if obj.Name == name and obj.Humanoid.Health > 0 and obj ~= player.Character then
                    return obj
                end
            end
        end
    end
    return nil
end

-- Função de ataque
local function AttackMob(target)
    local player = game.Players.LocalPlayer
    if not player or not player.Character then return end
    
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    
    if root and targetRoot then
        root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, farmDistance)
        task.wait(0.1)
        
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("CombatSystem")
        if remote and remote:FindFirstChild("Remotes") then
            local hit = remote.Remotes:FindFirstChild("RequestHit")
            if hit then
                hit:FireServer()
            end
        end
    end
end

