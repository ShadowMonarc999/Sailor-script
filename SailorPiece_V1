-- Função para pegar armas do inventário
local function GetMyInventory()
    local Tools = {}  -- Deixa as {} Vazias
    pcall(function()
        -- Pega armas do Backpack
        for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do 
            if v:IsA("Tool") then 
                table.insert(Tools, v.Name) 
            end 
        end
        -- Pega armas equipadas no personagem
        if LocalPlayer.Character then
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do 
                if v:IsA("Tool") then 
                    table.insert(Tools, v.Name) 
                end 
            end
        end
    end)
    -- Remove duplicatas
    local unique = {}
    for _, v in ipairs(Tools) do
        if not unique[v] then
            unique[v] = true
        end
    end
    local result = {}
    for k in pairs(unique) do
        table.insert(result, k)
    end
    return result
end
