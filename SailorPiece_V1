-- ESP Player
MainFeatures:NewToggle("ESP Player","Ver Player", function(state)
    getgenv().ESPEnabled = state
    if state then
        -- Função para criar ESP
        local function createESP(player)
            if player == LocalPlayer then return end
            
            local esp = Instance.new("Highlight")
            esp.Name = player.Name .. "_ESP"
            esp.FillColor = Color3.fromRGB(255, 0, 0)
            esp.OutlineColor = Color3.fromRGB(255, 255, 255)
            esp.FillTransparency = 0.5
            esp.OutlineTransparency = 0
            esp.Parent = player.Character or player.CharacterAdded:Wait()
            
            player.CharacterAdded:Connect(function(char)
                wait(0.5)
                local newESP = Instance.new("Highlight")
                newESP.Name = player.Name .. "_ESP"
                newESP.FillColor = Color3.fromRGB(255, 0, 0)
                newESP.OutlineColor = Color3.fromRGB(255, 255, 255)
                newESP.FillTransparency = 0.5
                newESP.OutlineTransparency = 0
                newESP.Parent = char
            end)
        end
        
        -- Criar ESP para jogadores existentes
        for _, player in ipairs(Players:GetPlayers()) do
            createESP(player)
        end
        
        -- Conectar para novos jogadores
        Players.PlayerAdded:Connect(createESP)
        
        print("ESP Player ATIVADO")
        Notificar("ESP", "Ativado - Jogadores destacados em vermelho", 2)
    else
        -- Remover ESP
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                local esp = player.Character:FindFirstChild(player.Name .. "_ESP")
                if esp then esp:Destroy() end
            end
        end
        print("ESP Player DESATIVADO")
        Notificar("ESP", "Desativado", 2)
    end
end)

