-- Função para teleportar (se disponível no jogo)
local function TeleportarPara(posicao)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    -- Método 1: CFrames (funciona na maioria dos jogos)
    pcall(function()
        root.CFrame = CFrame.new(posicao)
    end)
    
    -- Método 2: BodyVelocity (mais suave)
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = (posicao - root.Position).Unit * 1000
    bv.MaxForce = Vector3.new(1,1,1) * 9e9
    bv.Parent = root
    
    task.wait(0.1)
    bv:Destroy()
    
    return true
end

-- Função para mover até uma posição
local function MoverAte(posicao)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not root then return false end
    
    -- Calcular distância
    local distancia = (root.Position - posicao).Magnitude
    
    -- Se estiver muito longe e teleporte estiver ativado, tentar teleportar
    if distancia > getgenv().Config.DistanciaTeleporte and getgenv().Config.UsarTeleporte then
        TeleportarPara(posicao)
        return true
    end
    
    -- Mover caminhando
    humanoid:MoveTo(posicao)
    
    -- Aguardar chegar perto
    local tempoEspera = 0
    while (root.Position - posicao).Magnitude > getgenv().Config.DistanciaFarm and tempoEspera < 10 do
        task.wait(0.1)
        tempoEspera = tempoEspera + 0.1
        humanoid:MoveTo(posicao)
    end
    
    return true
end

