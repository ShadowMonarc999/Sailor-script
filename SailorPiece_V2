    Label.BackgroundTransparency = 1
    Label.Text = texto
    Label.TextColor3 = Cores.Text
    Label.TextSize = 16
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    -- Fundo do interruptor
    local SwitchBg = Instance.new("Frame")
    SwitchBg.Size = UDim2.new(0, 60, 0, 30)
    SwitchBg.Position = UDim2.new(1, -70, 0.5, -15)
    SwitchBg.BackgroundColor3 = Cores.Background3
    SwitchBg.BackgroundTransparency = 0.3
    SwitchBg.Parent = Frame
    
    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(0, 15)
    SwitchCorner.Parent = SwitchBg
    
    -- Botão do interruptor
    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 30, 0, 26)
    SwitchBtn.Position = UDim2.new(0, 2, 0.5, -13)
    SwitchBtn.BackgroundColor3 = Cores.Vermelho
    SwitchBtn.Text = ""
    SwitchBtn.Parent = SwitchBg
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 13)
    BtnCorner.Parent = SwitchBtn
    
    -- Estado inicial
    local estado = getgenv().Config[configVar]
    if estado then
        SwitchBtn.BackgroundColor3 = Cores.Azul
        SwitchBtn.Position = UDim2.new(1, -32, 0.5, -13)
    end
    
    -- Função de clique
    SwitchBtn.MouseButton1Click:Connect(function()
        estado = not estado
        getgenv().Config[configVar] = estado
        
        if estado then
            -- Animação para LIGADO (azul)
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {
                Position = UDim2.new(1, -32, 0.5, -13),
                BackgroundColor3 = Cores.Azul
            }):Play()
            
            -- Iniciar loop se for AutoFarm
            if configVar == "AutoFarmAtivo" and estado then
                task.spawn(LoopFarm)
            end
        else
            -- Animação para DESLIGADO (vermelho)
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {
                Position = UDim2.new(0, 2, 0.5, -13),
                BackgroundColor3 = Cores.Vermelho
            }):Play()
        end
    end)
    
    return Frame
end

