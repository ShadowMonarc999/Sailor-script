-- Verificar se é NPC de quest (para IGNORAR)
local function ENPCQuest(model)
    if not model then return false end
    local nome = model.Name:lower()
    
    for _, npc in ipairs(ListaQuestNPCs) do
        if nome:find(npc:lower()) then
            return true
        end
    end
    return false
end

-- Verificar se é monstro válido para farmar
local function EMonstroValido(model)
    if not model then return false end
    if model == LocalPlayer.Character then return false end
    
    -- Verificar se tem os componentes necessários
    local hp = model:FindFirstChild("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    
    if not hp or not root then return false end
    if hp.Health <= 0 then return false end
    
    -- IGNORAR NPCs de quest
    if ENPCQuest(model) then return false end
    
    -- Se tem alvos selecionados, verificar se este está na lista
    local alvos = getgenv().Config.AlvosSelecionados
    if alvos and #alvos > 0 then
        local nome = model.Name
        for _, alvo in ipairs(alvos) do
            if nome:find(alvo) then
                return true
            end
        end
        return false
    end
    
    -- Se não tem alvos selecionados, considerar qualquer monstro
    return hp.MaxHealth > 10
end

-- Pegar monstro mais próximo
local function PegarMonstroMaisProximo()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local root = char.HumanoidRootPart
    local menorDist = getgenv().Config.DistanciaVisao
    local alvo = nil
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if EMonstroValido(obj) then
            local dist = (root.Position - obj.HumanoidRootPart.Position).Magnitude
            if dist < menorDist then
                menorDist = dist
                alvo = obj
            end
        end
    end
    
    return alvo
end

-- Função para escanear NPCs próximos
local function EscanearNPCsProximos()
    local npcsEncontrados = {}
    local char = LocalPlayer.Character
    if not char then return npcsEncontrados end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local hp = obj:FindFirstChild("Humanoid")
            if hp and hp.Health > 0 then
                local nome = obj.Name
                -- Ignorar NPCs de quest no scan
                if not ENPCQuest(obj) then
                    if not table.find(npcsEncontrados, nome) then
                        table.insert(npcsEncontrados, nome)
                    end
                end
            end
        end
    end
    
    table.sort(npcsEncontrados)
    return npcsEncontrados
end

-- Equipar arma
local function EquiparArma()
    if not getgenv().Config.AutoEquiparArma then return end
    if getgenv().Config.ArmaSelecionada == "None" then return end
    
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    
    if char and not char:FindFirstChild(getgenv().Config.ArmaSelecionada) then
        local arma = backpack:FindFirstChild(getgenv().Config.ArmaSelecionada)
        if arma then
            char.Humanoid:EquipTool(arma)
        end
    end
end

-- Atacar (tenta diferentes métodos)
local function Atacar()
    local success = pcall(function()
        -- Método 1: Tentar remote comum
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("CombatSystem")
        if remote then
            local hitRemote = remote:FindFirstChild("Remotes"):FindFirstChild("RequestHit")
            if hitRemote then
                hitRemote:FireServer()
                return
            end
        end
        
        -- Método 2: Tentar outros remotes
        local possiveis = {
            "Damage", "Hit", "Attack", "DealDamage", "RequestDamage"
        }
        
        for _, nome in ipairs(possiveis) do
            local remote = game:GetService("ReplicatedStorage"):FindFirstChild(nome)
            if remote then
                remote:FireServer()
                return
            end
        end
        
        -- Método 3: Simular clique
        local input = game:GetService("VirtualInputManager")
        input:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 0)
        task.wait(0.05)
        input:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 0)
    end)
    
    return success
end

-- Loop de Farm
local function LoopFarm()
    while getgenv().Config.AutoFarmAtivo do
        task.wait(0.1)
        
        local alvo = PegarMonstroMaisProximo()
        
        if alvo and alvo:FindFirstChild("HumanoidRootPart") then
            local rootAlvo = alvo.HumanoidRootPart
            local hpAlvo = alvo:FindFirstChild("Humanoid")
            
            while getgenv().Config.AutoFarmAtivo and hpAlvo and hpAlvo.Health > 0 do
                task.wait(0.05)
                
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                if root and rootAlvo then
                    -- Equipar arma
                    EquiparArma()
                    
                    -- Mover para o alvo
                    root.CFrame = rootAlvo.CFrame * CFrame.new(0, getgenv().Config.DistanciaFarm, 0)
                    
                    -- Atacar
                    Atacar()
                    
                    -- Usar habilidades se ativado
                    if getgenv().Config.AutoUsarHabilidades then
                        local input = game:GetService("VirtualInputManager")
                        local teclas = {"Z", "X", "C", "V"}
                        for _, tecla in ipairs(teclas) do
                            input:SendKeyEvent(true, tecla, false, game)
                            task.wait(0.01)
                            input:SendKeyEvent(false, tecla, false, game)
                        end
                    end
                else
                    break
                end
            end
        else
            task.wait(0.5)
        end
    end
end

-- ============================================
-- [[ FUNÇÃO PARA CRIAR INTERRUPTOR ]]
-- ============================================
local function CriarInterruptor(pai, posY, texto, configVar)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -20, 0, 40)
    Frame.Position = UDim2.new(0, 10, 0, posY)
    Frame.BackgroundTransparency = 1
    Frame.Parent = pai
    
    -- Texto
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 200, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = texto
    Label.TextColor3 = Cores.Text
    Label.TextSize = 16
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    -- Fundo do interruptor
    local SwitchBg = Instance.new("Frame")
    SwitchBg.Size = UDim2.new(0, 60, 0, 30)
    SwitchBg.Position = UDim2.new(1, -70, 0.5, -15)
    SwitchBg.BackgroundColor3 = Cores.Background3
    SwitchBg.BackgroundTransparency = 0.3
    SwitchBg.Parent = Frame
    
    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(0, 15)
    SwitchCorner.Parent = SwitchBg
    
    -- Botão do interruptor
    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 30, 0, 26)
    SwitchBtn.Position = UDim2.new(0, 2, 0.5, -13)
    SwitchBtn.BackgroundColor3 = Cores.Vermelho
    SwitchBtn.Text = ""
    SwitchBtn.Parent = SwitchBg
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 13)
    BtnCorner.Parent = SwitchBtn
    
    -- Estado inicial
    local estado = getgenv().Config[configVar]
    if estado then
        SwitchBtn.BackgroundColor3 = Cores.Azul
        SwitchBtn.Position = UDim2.new(1, -32, 0.5, -13)
    end
    
    -- Função de clique
    SwitchBtn.MouseButton1Click:Connect(function()
        estado = not estado
        getgenv().Config[configVar] = estado
        
        if estado then
            -- Animação para LIGADO (azul)
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {
                Position = UDim2.new(1, -32, 0.5, -13),
                BackgroundColor3 = Cores.Azul
            }):Play()
            -- Iniciar loop se for AutoFarm
            if configVar == "AutoFarmAtivo" and estado then
                task.spawn(LoopFarm)
            end
        else
            -- Animação para DESLIGADO (vermelho)
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {
                Position = UDim2.new(0, 2, 0.5, -13),
                BackgroundColor3 = Cores.Vermelho
            }):Play()
        end
    end)
    
    return Frame
end

