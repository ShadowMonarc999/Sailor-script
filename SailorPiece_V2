-- Função: ÉNPCDeQuest - Verifica se é NPC de quest
local function ENPCDeQuest(model)
    if not model then return false end
    
    local nome = model.Name:lower()
    local npcsQuest = {"quest", "giver", "npc", "merchant", "tutor", "guide", "quest giver"}
    
    for _, palavra in ipairs(npcsQuest) do
        if nome:find(palavra) then
            return true
        end
    end
    
    return false
end

-- Função: ÉMonstro - Verifica se é monstro atacável
local function EMonstro(model)
    if not model then return false end
    
    if model == game.Players.LocalPlayer.Character then return false end
    
    local hp = model:FindFirstChild("Humanoid")
    local rootPart = model:FindFirstChild("HumanoidRootPart")
    
    if not hp or not rootPart then return false end
    if hp.Health <= 0 then return false end
    
    if ENPCDeQuest(model) then return false end
    
    local nome = model.Name:lower()
    for _, boss in ipairs(ListaChefes) do
        if nome:find(boss:lower()) then
            return true
        end
    end
    
    return hp.MaxHealth > 10
end

-- Função: PegarMonstrosProximos
local function PegarMonstrosProximos()
    local monstros = {}
    local personagem = game.Players.LocalPlayer.Character
    
    if not personagem or not personagem:FindFirstChild("HumanoidRootPart") then
        return {"Nenhum"}
    end
    
    for _, objeto in pairs(game.Workspace:GetDescendants()) do
        if EMonstro(objeto) then
            local distancia = (personagem.HumanoidRootPart.Position - objeto.HumanoidRootPart.Position).Magnitude
            if distancia <= getgenv().Config.DistanciaVisao then
                table.insert(monstros, objeto.Name)
            end
        end
    end
    
    if #monstros == 0 then
        table.insert(monstros, "Nenhum")
    end
    
    return monstros
end

-- Função: PegarArmasInventario
local function PegarArmasInventario()
    local armas = {"None"}
    
    pcall(function()
        local backpack = game.Players.LocalPlayer.Backpack
        local character = game.Players.LocalPlayer.Character
        
        for _, ferramenta in pairs(backpack:GetChildren()) do
            if ferramenta:IsA("Tool") then
                table.insert(armas, ferramenta.Name)
            end
        end
        
        if character then
            for _, ferramenta in pairs(character:GetChildren()) do
                if ferramenta:IsA("Tool") then
                    table.insert(armas, ferramenta.Name)
                end
            end
        end
    end)
    
    return armas
end

-- Função: EquiparArma
local function EquiparArma()
    pcall(function()
        if getgenv().Config.AutoEquiparArma and getgenv().Config.ArmaSelecionada ~= "None" then
            local personagem = game.Players.LocalPlayer.Character
            local backpack = game.Players.LocalPlayer.Backpack
            
            if personagem and not personagem:FindFirstChild(getgenv().Config.ArmaSelecionada) then
                local arma = backpack:FindFirstChild(getgenv().Config.ArmaSelecionada)
                if arma then
                    personagem.Humanoid:EquipTool(arma)
                end
            end
        end
    end)
end

-- Função: AtacarAlvo
local function AtacarAlvo()
    pcall(function()
        local remote = game:GetService("ReplicatedStorage"):WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        
        if remote then
            remote:FireServer()
            
            if getgenv().Config.AutoUsarHabilidades then
                local input = game:GetService("VirtualInputManager")
                local teclas = {"Z", "X", "C", "V", "F"}
                
                for _, tecla in ipairs(teclas) do
                    input:SendKeyEvent(true, tecla, false, game)
                    task.wait(0.01)
                    input:SendKeyEvent(false, tecla, false, game)
                end
            end
        end
    end)
end

-- Função: PegarMonstroMaisProximo
local function PegarMonstroMaisProximo()
    local personagem = game.Players.LocalPlayer.Character
    if not personagem or not personagem:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    local rootPersonagem = personagem.HumanoidRootPart
    local menorDistancia = getgenv().Config.DistanciaVisao
    local alvoProximo = nil
    
    local npcsSelecionados = getgenv().Config.NPCstargetados
    
    for _, objeto in pairs(game.Workspace:GetDescendants()) do
        if EMonstro(objeto) then
            local eSelecionado = false
            
            if npcsSelecionados and #npcsSelecionados > 0 then
                for _, nomeSelecionado in ipairs(npcsSelecionados) do
                    if objeto.Name == nomeSelecionado then
                        eSelecionado = true
                        break
                    end
                end
            end
            
            if (npcsSelecionados == nil or #npcsSelecionados == 0) or eSelecionado then
                local distancia = (rootPersonagem.Position - objeto.HumanoidRootPart.Position).Magnitude
                if distancia < menorDistancia then
                    menorDistancia = distancia
                    alvoProximo = objeto
                end
            end
        end
    end
    
    return alvoProximo
end

-- Função: PegarChefeProximo
local function PegarChefeProximo()
    local personagem = game.Players.LocalPlayer.Character
    if not personagem or not personagem:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    for _, objeto in pairs(game.Workspace:GetDescendants()) do
        if EMonstro(objeto) then
            if objeto ~= personagem and objeto.Humanoid.Health > 0 then
                if objeto.Humanoid.MaxHealth > 1000 then
                    local distancia = (personagem.HumanoidRootPart.Position - objeto.HumanoidRootPart.Position).Magnitude
                    if distancia <= getgenv().Config.DistanciaVisao then
                        return objeto
                    end
                end
            end
        end
    end
    
    return nil
end

