local function CriarSlider(pai, posY, texto, min, max, configVar, sufixo)
    sufixo = sufixo or "studs"
    
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -20, 0, 80)
    Frame.Position = UDim2.new(0, 10, 0, posY)
    Frame.BackgroundColor3 = Cores.Background3
    Frame.BackgroundTransparency = 0.3
    Frame.Parent = pai
    
    local SliderCorner = Instance.new("UICorner")
    SliderCorner.CornerRadius = UDim.new(0, 6)
    SliderCorner.Parent = Frame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 0, 25)
    Label.Position = UDim2.new(0, 10, 0, 5)
    Label.BackgroundTransparency = 1
    Label.Text = texto .. ": " .. getgenv().Config[configVar] .. " " .. sufixo
    Label.TextColor3 = Cores.Text
    Label.TextSize = 15
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    -- Container da barra (para facilitar posicionamento)
    local BarraContainer = Instance.new("Frame")
    BarraContainer.Size = UDim2.new(1, -40, 0, 20)
    BarraContainer.Position = UDim2.new(0, 20, 0, 40)
    BarraContainer.BackgroundTransparency = 1
    BarraContainer.Parent = Frame
    
    -- Barra do slider
    local Barra = Instance.new("Frame")
    Barra.Size = UDim2.new(1, 0, 0, 4)
    Barra.Position = UDim2.new(0, 0, 0.5, -2)
    Barra.BackgroundColor3 = Cores.Background2
    Barra.BackgroundTransparency = 0.3
    Barra.Parent = BarraContainer
    
    local BarraCorner = Instance.new("UICorner")
    BarraCorner.CornerRadius = UDim.new(0, 2)
    BarraCorner.Parent = Barra
    
    -- Botão do slider
    local SliderBtn = Instance.new("TextButton")
    SliderBtn.Size = UDim2.new(0, 20, 0, 20)
    SliderBtn.Position = UDim2.new(0, -10, 0.5, -10)
    SliderBtn.BackgroundColor3 = Cores.Azul
    SliderBtn.Text = ""
    SliderBtn.AutoButtonColor = false
    SliderBtn.Parent = BarraContainer
    
    local SliderBtnCorner = Instance.new("UICorner")
    SliderBtnCorner.CornerRadius = UDim.new(0, 10)
    SliderBtnCorner.Parent = SliderBtn
    
    -- Botão invisível para capturar cliques na barra inteira
    local ClickCatcher = Instance.new("TextButton")
    ClickCatcher.Size = UDim2.new(1, 0, 1, 0)
    ClickCatcher.BackgroundTransparency = 1
    ClickCatcher.Text = ""
    ClickCatcher.AutoButtonColor = false
    ClickCatcher.Parent = BarraContainer
    
    -- Valor atual em porcentagem
    local valorAtual = getgenv().Config[configVar]
    local porcentagem = (valorAtual - min) / (max - min)
    SliderBtn.Position = UDim2.new(porcentagem, -10, 0.5, -10)
    
    -- Variáveis para controle de arrasto
    local arrastando = false
    local conexaoMovimento = nil
    local conexaoSoltar = nil
    
    -- Função para atualizar valor
    local function atualizarValor(x)
        local containerPos = BarraContainer.AbsolutePosition.X
        local containerLargura = BarraContainer.AbsoluteSize.X
        local novaPorcentagem = (x - containerPos) / containerLargura
        novaPorcentagem = math.clamp(novaPorcentagem, 0, 1)
        
        local novoValor = math.floor(min + (max - min) * novaPorcentagem)
        getgenv().Config[configVar] = novoValor
        Label.Text = texto .. ": " .. novoValor .. " " .. sufixo
        SliderBtn.Position = UDim2.new(novaPorcentagem, -10, 0.5, -10)
    end
    
    -- Função para iniciar arrasto
    local function iniciarArrasto(input)
        arrastando = true
        atualizarValor(input.Position.X)
        
        -- Conectar eventos de movimento e soltar
        conexaoMovimento = UserInputService.InputChanged:Connect(function(inp)
            if arrastando and inp.UserInputType == Enum.UserInputType.MouseMovement then
                atualizarValor(inp.Position.X)
            end
        end)
        
        conexaoSoltar = UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                arrastando = false
                if conexaoMovimento then
                    conexaoMovimento:Disconnect()
                    conexaoMovimento = nil
                end
                if conexaoSoltar then
                    conexaoSoltar:Disconnect()
                    conexaoSoltar = nil
                end
            end
        end)
    end
    
    -- Evento no botão do slider
    SliderBtn.MouseButton1Down:Connect(iniciarArrasto)
    
    -- Evento no catcher (barra inteira)
    ClickCatcher.MouseButton1Down:Connect(iniciarArrasto)
    
    return Frame
end

