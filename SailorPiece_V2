local function MostrarAba(aba)
    FarmContainer.Visible = (aba == "Farm")
    NPCContainer.Visible = (aba == "NPC")
    MovContainer.Visible = (aba == "Mov")
    BossContainer.Visible = (aba == "Boss")
    ConfigContainer.Visible = (aba == "Config")
    
    -- Resetar cores das abas
    AbaFarm.BackgroundColor3 = Cores.Background3
    AbaFarm.TextColor3 = Cores.TextDim
    AbaNPC.BackgroundColor3 = Cores.Background3
    AbaNPC.TextColor3 = Cores.TextDim
    AbaMov.BackgroundColor3 = Cores.Background3
    AbaMov.TextColor3 = Cores.TextDim
    AbaBoss.BackgroundColor3 = Cores.Background3
    AbaBoss.TextColor3 = Cores.TextDim
    AbaConfig.BackgroundColor3 = Cores.Background3
    AbaConfig.TextColor3 = Cores.TextDim
    
    -- Destacar aba selecionada
    if aba == "Farm" then
        AbaFarm.BackgroundColor3 = Cores.Azul
        AbaFarm.TextColor3 = Cores.Text
    elseif aba == "NPC" then
        AbaNPC.BackgroundColor3 = Cores.Verde
        AbaNPC.TextColor3 = Cores.Text
    elseif aba == "Mov" then
        AbaMov.BackgroundColor3 = Cores.Laranja
        AbaMov.TextColor3 = Cores.Text
    elseif aba == "Boss" then
        AbaBoss.BackgroundColor3 = Cores.Vermelho
        AbaBoss.TextColor3 = Cores.Text
    elseif aba == "Config" then
        AbaConfig.BackgroundColor3 = Cores.Roxo
        AbaConfig.TextColor3 = Cores.Text
    end
end

