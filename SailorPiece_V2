-- [[ LOOPS DE FARM ]]
-- ============================================

local function LoopFarm()
    while getgenv().Config.AutoFarmAtivo do
        task.wait(0.1)
        
        local alvo = PegarMonstroMaisProximo()
        
        if alvo and alvo:FindFirstChild("HumanoidRootPart") then
            local rootAlvo = alvo.HumanoidRootPart
            local humanoideAlvo = alvo:FindFirstChild("Humanoid")
            
            while getgenv().Config.AutoFarmAtivo and humanoideAlvo and humanoideAlvo.Health > 0 do
                task.wait(0.01)
                
                local char = game.Players.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                if root and rootAlvo then
                    EquiparArma()
                    
                    root.Velocity = Vector3.new(0, 0, 0)
                    root.RotVelocity = Vector3.new(0, 0, 0)
                    
                    root.CFrame = rootAlvo.CFrame * CFrame.new(0, getgenv().Config.DistanciaFarm, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    
                    AtacarAlvo()
                else
                    break
                end
            end
        else
            task.wait(0.5)
        end
    end
end

local function LoopBoss()
    while getgenv().Config.AutoBossAtivo do
        task.wait(1)
        
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer("Shinjuku")
        end)
        
        task.wait(2)
        
        pcall(function()
            local args = {[1] = getgenv().Config.BossSelecionado, [2] = getgenv().Config.DificuldadeBoss}
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestSpawnStrongestBoss"):FireServer(unpack(args))
        end)
        
        while getgenv().Config.AutoBossAtivo do
            task.wait(0.05)
            
            local boss = PegarChefeProximo()
            if boss then
                local char = game.Players.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local bossRoot = boss:FindFirstChild("HumanoidRootPart")
                
                if root and bossRoot then
                    EquiparArma()
                    root.CFrame = bossRoot.CFrame * CFrame.new(0, getgenv().Config.DistanciaFarm, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    AtacarAlvo()
                end
            else
                task.wait(3)
                pcall(function()
                    local args = {[1] = getgenv().Config.BossSelecionado, [2] = getgenv().Config.DificuldadeBoss}
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestSpawnStrongestBoss"):FireServer(unpack(args))
                end)
            end
        end
    end
end

