-- Função para atualizar lista de NPCs
local function AtualizarListaNPCs()
    -- Limpar lista atual
    for _, child in pairs(NPCListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Escanear NPCs próximos
    local npcs = EscanearNPCsProximos()
    
    if #npcs == 0 then
        local msg = Instance.new("TextLabel")
        msg.Size = UDim2.new(1, -10, 0, 50)
        msg.BackgroundTransparency = 1
        msg.Text = "Nenhum NPC encontrado por perto!"
        msg.TextColor3 = Cores.TextDim
        msg.TextSize = 14
        msg.Font = Enum.Font.SourceSans
        msg.Parent = NPCListFrame
        return
    end
    
    for _, nome in ipairs(npcs) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, -10, 0, 40)
        item.BackgroundColor3 = Cores.Background2
        item.BackgroundTransparency = 0.2
        item.Parent = NPCListFrame
        
        local itemCorner = Instance.new("UICorner")
        itemCorner.CornerRadius = UDim.new(0, 4)
        itemCorner.Parent = item
        
        local nomeLabel = Instance.new("TextLabel")
        nomeLabel.Size = UDim2.new(0, 200, 1, 0)
        nomeLabel.Position = UDim2.new(0, 10, 0, 0)
        nomeLabel.BackgroundTransparency = 1
        nomeLabel.Text = nome
        nomeLabel.TextColor3 = Cores.Text
        nomeLabel.TextSize = 14
        nomeLabel.Font = Enum.Font.SourceSans
        nomeLabel.TextXAlignment = Enum.TextXAlignment.Left
        nomeLabel.Parent = item
        
        local selectBtn = Instance.new("TextButton")
        selectBtn.Size = UDim2.new(0, 100, 0, 30)
        selectBtn.Position = UDim2.new(1, -110, 0.5, -15)
        selectBtn.BackgroundColor3 = Cores.Azul
        selectBtn.Text = "SELECIONAR"
        selectBtn.TextColor3 = Cores.Text
        selectBtn.TextSize = 12
        selectBtn.Font = Enum.Font.SourceSansBold
        selectBtn.Parent = item
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = selectBtn
        
        -- Verificar se já está selecionado
        local alvos = getgenv().Config.AlvosSelecionados
        for _, alvo in ipairs(alvos) do
            if alvo == nome then
                selectBtn.BackgroundColor3 = Cores.Verde
                selectBtn.Text = "✓ SELECIONADO"
                break
            end
        end
        
        selectBtn.MouseButton1Click:Connect(function()
            local alvos = getgenv().Config.AlvosSelecionados
            local encontrado = false
            local pos = 0
            
            for i, alvo in ipairs(alvos) do
                if alvo == nome then
                    encontrado = true
                    pos = i
                    break
                end
            end
            
            if encontrado then
                -- Remover da lista
                table.remove(alvos, pos)
                selectBtn.BackgroundColor3 = Cores.Azul
                selectBtn.Text = "SELECIONAR"
                Notificar("Alvo Removido", nome .. " removido da lista!", 2)
            else
                -- Adicionar à lista
                table.insert(alvos, nome)
                selectBtn.BackgroundColor3 = Cores.Verde
                selectBtn.Text = "✓ SELECIONADO"
                Notificar("Alvo Adicionado", nome .. " será farmado!", 2)
            end
        end)
    end
end

