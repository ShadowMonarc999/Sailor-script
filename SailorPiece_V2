local function MostrarAba(aba)
    FarmContainer.Visible = (aba == "Farm")
    BossContainer.Visible = (aba == "Boss")
    QuestContainer.Visible = (aba == "Quest")
    ConfigContainer.Visible = (aba == "Config")
    
    -- Resetar cores das abas
    AbaFarm.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AbaBoss.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AbaQuest.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AbaConfig.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    
    -- Destacar aba selecionada
    if aba == "Farm" then
        AbaFarm.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    elseif aba == "Boss" then
        AbaBoss.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    elseif aba == "Quest" then
        AbaQuest.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
    elseif aba == "Config" then
        AbaConfig.BackgroundColor3 = Color3.fromRGB(200, 200, 0)
    end
end

